# Public API base URL (inlined into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side API base URL (SSR/ISR fetches; required in production)
INTERNAL_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1

# Public site origin (metadata/canonical URLs)
WEB_URL=http://localhost:3000

# API request timeout in ms
NEXT_PUBLIC_API_TIMEOUT_MS=8000
